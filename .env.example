# Blockchain Voting DApp Environment Variables
# Copy this file to .env.local and fill in your values

# Blockchain Configuration
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
NEXT_PUBLIC_VOTING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_NETWORK_NAME=Ethereum Mainnet

# Blockchain Explorer
NEXT_PUBLIC_EXPLORER_URL=https://etherscan.io

# Application Configuration
NEXT_PUBLIC_APP_NAME=Blockchain Voting DApp
NEXT_PUBLIC_APP_DESCRIPTION=Secure, transparent, and immutable voting system
